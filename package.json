    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.0.3",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "icon": "logo.png"
