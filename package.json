{
  "displayName": "Heatzy for Homebridge",
  "name": "homebridge-heatzy-pilote-platform",
  "version": "2.0.0",
  "description": "Use Heatzy modules with Homebridge as switches",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julienott/homebridge-heatzy-pilote-platform.git"
  },
  "bugs": {
    "url": "https://github.com/julienott/homebridge-heatzy-pilote-platform/issues"
  },
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0",
    "node": "^18.20.4 || ^20.15.1"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
