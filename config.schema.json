{
  "pluginAlias": "Heatzy",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "<p align=\"center\"><img width=\"60%\" src=\"https://raw.githubusercontent.com/julienott/homebridge-heatzy-pilote-platform/latest/heatzy.png\" /></p><p align=\"center\">Please provide your Heatzy login details</p>",
  "footerDisplay": "These should be the same credentials you use in the Heatzy app.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Heatzy",
        "required": true
      },
      "credentials": {
        "type": "object",
        "title": "Heatzy Account",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "title": "Email",
            "type": "string",
            "required": true
          },
          "password": {
            "title": "Password",
            "type": "string",
            "required": true,
            "format": "password"
          }
        }
      },
      "switches": {
        "type": "object",
        "title": "Switch Configuration",
        "properties": {
          "modes": {
            "title": "Choose the switch modes you wish to show",
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["Confort", "Eco", "Eco Plus", "Sleep", "Antifreeze"]
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      },
      "security": {
        "type": "object",
        "title": "Security Settings",
        "properties": {
          "lockThermostats": {
            "title": "Lock Thermostats",
            "type": "boolean",
            "default": false,
            "description": "Lock thermostats after mode changes to prevent manual adjustments"
          }
        }
      }
    }
  }
}